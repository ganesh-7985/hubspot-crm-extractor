{
  "manifest_version": 3,
  "name": "HubSpot CRM Extractor",
  "version": "1.0.0",
  "description": "Extract Contacts, Deals, and Tasks from HubSpot CRM and manage them locally",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://app.hubspot.com/*",
    "https://*.hubspot.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker-bundle.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.hubspot.com/*",
        "https://app-na2.hubspot.com/*",
        "https://app-eu1.hubspot.com/*",
        "https://*.hubspot.com/*"
      ],
      "js": ["src/content/content-bundle.js"],
      "css": ["src/content/content-styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "HubSpot CRM Extractor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
